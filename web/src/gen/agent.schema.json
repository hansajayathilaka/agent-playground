{
  "$defs": {
    "Approvals": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/ApprovalsMode",
          "default": "risky"
        }
      },
      "title": "Approvals",
      "type": "object"
    },
    "ApprovalsMode": {
      "enum": [
        "off",
        "risky",
        "all"
      ],
      "title": "ApprovalsMode",
      "type": "string"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "max_turns": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Turns"
        },
        "max_budget_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Budget Usd"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "Network": {
      "additionalProperties": false,
      "properties": {
        "allowlist": {
          "items": {
            "type": "string"
          },
          "title": "Allowlist",
          "type": "array"
        }
      },
      "title": "Network",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema for agent.json. Unknown keys are errors so typos surface early.",
  "properties": {
    "schema_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 2000,
      "title": "Description",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "credential_set": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential Set"
    },
    "tool_packs": {
      "items": {
        "type": "string"
      },
      "title": "Tool Packs",
      "type": "array"
    },
    "approvals": {
      "$ref": "#/$defs/Approvals"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "network": {
      "$ref": "#/$defs/Network"
    }
  },
  "required": [
    "name"
  ],
  "title": "AgentManifest",
  "type": "object"
}
