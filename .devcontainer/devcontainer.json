{
  "name": "Agent Playground",
  "dockerComposeFile": ["../deploy/compose.yaml", "compose.yaml"],
  "service": "dev",
  "runServices": ["dev", "postgres", "redis", "envoy"],
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22", "pnpmVersion": "10.28.0" },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "remoteEnv": { "UV_PROJECT_ENVIRONMENT": "/workspace/.venv" },
  "postCreateCommand": "uv sync && (cd web && pnpm install)",
  "forwardPorts": [8080],
  "portsAttributes": { "8080": { "label": "Envoy (UI + API)" } },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-pyright.pyright",
        "biomejs.biome",
        "bufbuild.vscode-buf"
      ]
    }
  }
}
